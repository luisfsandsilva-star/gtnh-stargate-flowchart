"rpatch:verified:rc2:acquisition:primordial-pearl-warden" [shape=box,style="filled",fillcolor="#faf0da",label="Conditional natural\nacquisition: defeat Eldritch\nWarden",tooltip="acquisitionEvent: true\nsourceEntity: \"thaumcraft/common/entities/monster/boss/EntityEldritchWarden\"\nlocation: \"Outer Lands boss encounter; find a Warden encounter, not a guaranteed Warden in every room.\"\nprobability: 1.0\nquantity: 1\nfortuneAffectsPearlCount: false\ninheritanceEvidence: {\"url\": \"https://mediafilez.forgecdn.net/files/2227/552/Thaumcraft-1.7.10-4.2.3.5.jar\", \"class\": \"thaumcraft/common/entities/monster/boss/EntityEldritchWarden.class\", \"decompiledLine\": 101, \"extends\": \"EntityThaumcraftBoss\"}\ndropRule: \"Base boss dropFewItems unconditionally calls entityDropSpecialItem with new ItemStack(ConfigItems.itemEldritchObject,1,3). No random roll or fortune-dependent quantity in this method.\"\nlootCondition: \"Normal enabled mob drops; events or server rules must not suppress drops.\"\nspecialItemEmissionEvidence: {\"url\": \"https://mediafilez.forgecdn.net/files/2227/552/Thaumcraft-1.7.10-4.2.3.5.jar\", \"class\": \"thaumcraft/common/lib/utils/EntityUtils.class\", \"decompiledLine\": 221}\notherDropsNotCounted: \"The same boss method also drops one rare loot bag; this patch models the Pearl only.\"\nPaso 1: Use established Outer Lands access.\nPaso 2: Reach and defeat an Eldritch Warden.\nPaso 3: Collect the one Primordial Pearl special-item drop."];
"iaccess:thaumcraft:outer-lands" -> "rpatch:verified:rc2:acquisition:primordial-pearl-warden" [label="1 · reutilizable",style=dashed];
"rpatch:verified:rc2:acquisition:primordial-pearl-warden" -> "ithaumcraft:itemeldritchobject@3" [label="1"];
"rpatch:verified:rc2:access:outer-lands-portal" [shape=box,style="filled",fillcolor="#faf0da",label="Sidequest: open an Eldritch\nPortal",tooltip="research: \"OCULUS complete\"\nlocation: \"Natural Eldritch altar/obelisk with DARK aura node directly above altar.\"\nmaze: \"TileEldritchAltar.checkForMaze() must report maze ready.\"\nwand: \"Reusable ItemWandCasting with enough capacity and stored vis; not consumed.\"\nbaseWandVisCost: {\"aer\": 100, \"ignis\": 100, \"terra\": 100, \"aqua\": 100, \"ordo\": 100, \"perditio\": 100}\nvisCostMeaning: \"Base displayed wand-vis units before wand/gear crafting consumption modifiers. This is not essentia; actual debited vis uses ItemWandCasting.getConsumptionModifier.\"\nportalActivationSource: {\"url\": \"https://mediafilez.forgecdn.net/files/2227/552/Thaumcraft-1.7.10-4.2.3.5.jar\", \"class\": \"thaumcraft/common/items/wands/WandManager.class\", \"decompiledLine\": 452}\nresearchCheckSource: {\"class\": \"thaumcraft/common/items/wands/WandManager.class\", \"decompiledLine\": 756}\nconsumptionSource: {\"class\": \"thaumcraft/common/items/wands/ItemWandCasting.class\", \"decompiledLine\": 325}\nreusableAccess: true\naccounting: \"Four Eldritch Eyes and wand-vis cost belong to opening one portal/expedition infrastructure. Do not charge four Eyes separately for every boss or Pearl.\"\nPaso 1: Complete OCULUS research and locate an eligible Eldritch altar.\nPaso 2: Insert four Eldritch Eyes; each insertion consumes one eye.\nPaso 3: After maze generation is ready, activate using a charged wand.\nPaso 4: Enter Outer Lands and progress through its maze to a boss encounter."];
"ithaumcraft:itemeldritchobject" -> "rpatch:verified:rc2:access:outer-lands-portal" [label="4"];
"rpatch:verified:rc2:access:outer-lands-portal" -> "iaccess:thaumcraft:outer-lands" [label="1"];
