"rpatch:verified:rc2:godforge:graviton-shard-ejection" [shape=box,style="filled",fillcolor="#faf0da",label="Forge of Gods · eject earned\nGraviton Shard",tooltip="conditionalStatefulOperation: true\nrequires: \"END active; Graviton Shard Ejection enabled; exactly one output bus; at least one available unspent internal Graviton credit.\"\nprogressDebitPerOutput: {\"gravitonShardsAvailable\": -1, \"gravitonShardsSpent\": 1}\nnotFreeRepeatableProduction: true\nactualBatch: \"Implementation attempts to eject all currently available credits; normalized here to one physical gem per one ejected credit.\"\nprogressGeneration: \"available = sum_i[p_i*(p_i+1)/2] - shardsSpent; p_i capped at7 before inversion. Source determineGravitonShardAmount L928.\"\nmilestoneTracks: [\"Charge: total power consumed by Godforge modules.\", \"Conversion: total recipes processed by Godforge modules.\", \"Catalyst: total Forge of Gods fuel consumed.\", \"Composition: structure/extensions and module composition.\"]\ninversionCondition: \"All four milestone tracks at least7 unlock inversion; later progress may exceed7.\"\nmilestoneSource: \"https://github.com/GTNewHorizons/GT5-Unofficial/blob/5.09.54.205/src/main/java/tectech/thing/metaTileEntity/multi/godforge/util/GodforgeMath.java#L342\"\nprogressConstantsSource: \"https://github.com/GTNewHorizons/GT5-Unofficial/blob/5.09.54.205/src/main/java/tectech/thing/metaTileEntity/multi/godforge/util/ForgeOfGodsData.java#L34\"\naccounting: \"There is no fixed item/fluid/EU recipe per Graviton Shard. Milestone progress requires previous machine operation, fuel, processing and power; exact marginal cost depends on saved Godforge state and chosen work.\"\nmachineTickSource: \"https://github.com/GTNewHorizons/GT5-Unofficial/blob/5.09.54.205/src/main/java/tectech/thing/metaTileEntity/multi/godforge/MTEForgeOfGods.java#L425\"\nPaso 1: Earn internal Graviton credits through the four Godforge milestone tracks.\nPaso 2: Activate the END upgrade and enable Graviton Shard Ejection.\nPaso 3: With one output bus available, eject credits as physical Graviton Shard gems; each emitted gem spends one credit."];
"iaccess:godforge:graviton-shard-ejection" -> "rpatch:verified:rc2:godforge:graviton-shard-ejection" [label="1 · reutilizable",style=dashed];
"rpatch:verified:rc2:godforge:graviton-shard-ejection" -> "igregtech:gt.metaitem.01@8150" [label="1"];
"rpatch:verified:rc2:godforge:unlock-end" [shape=box,style="filled",fillcolor="#faf0da",label="Forge of Gods · install END\nupgrade",tooltip="reusableUnlock: true\nupgradeId: \"END\"\nprerequisiteUpgrade: \"EE must be active, with its own prerequisite tree and material/progress costs satisfied.\"\ninternalGravitonCreditCost: 12\ninternalCurrencyNotPhysicalGem: true\ncostSource: \"https://github.com/GTNewHorizons/GT5-Unofficial/blob/5.09.54.205/src/main/java/tectech/thing/metaTileEntity/multi/godforge/upgrade/ForgeOfGodsUpgrade.java#L250\"\nscope: \"These materials and 12 internal credits are paid for installing END, not per emitted shard. No Graviton Shard or casing is manufactured by the fake upgrade-cost display.\"\nmachine: \"Existing formed and progressed Forge of Gods, relevant structure/modules and fuel infrastructure.\"\nPaso 1: Progress Forge of Gods and install prerequisites through EE.\nPaso 2: Submit END extra material costs and spend 12 internal Graviton credits to install END.\nPaso 3: Use the unlocked physical shard ejection option."];
