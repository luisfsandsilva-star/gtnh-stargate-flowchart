"rpatch:verified:rc2:acquisition:broken-spawner" [shape=box,style="filled",fillcolor="#faf0da",label="Natural acquisition: break\nvanilla mob spawner",tooltip="acquisitionEvent: true\nconsumeWorldStructure: \"One BlockMobSpawner with a valid TileEntityMobSpawner is destroyed. This is not an inventory crafting recipe.\"\nplayer: \"Non-creative player on server; uncancelled BreakEvent and HarvestDropsEvent.\"\nprobability: 1.0\nconfigSource: \"https://github.com/GTNewHorizons/GT-New-Horizons-Modpack/blob/2.9.0-nightly-2026-10-04/config/enderio/EnderIO.cfg#L979\"\ntoolBlacklist: [\"RotaryCraft:rotarycraft_item_bedpick\"]\nmobRestriction: \"Spawner entity name must not be blacklisted in PoweredSpawnerConfig.\"\nrequiredOutputNBT: \"mobType = entity name from original spawner; preserved in the Broken Spawner item.\"\nnbtConstructorSource: \"https://github.com/GTNewHorizons/EnderIO/blob/2.10.48/src/main/java/crazypants/enderio/machine/spawner/ItemBrokenSpawner.java#L34\"\nscope: \"Natural dungeon/mineshaft/fortress spawner, independent of Ender Fluidic EndoCrafting loops.\"\nPaso 1: Find an eligible natural mob spawner.\nPaso 2: Break it as a survival player using a nonblacklisted tool.\nPaso 3: Collect one Broken Spawner carrying the original mobType NBT."];
"rpatch:verified:rc2:acquisition:broken-spawner" -> "ienderio:itembrokenspawner" [label="1"];
