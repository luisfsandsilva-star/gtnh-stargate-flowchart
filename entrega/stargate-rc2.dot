"rpatch:verified:rc2:tconstruct:casting-basin:seared-stone" [shape=box,style="filled",fillcolor="#faf0da",label="TConstruct Casting Basin ·\nSeared Stone\n12.25 s",tooltip="cast: null\nconsumeCast: false\ncoolingTicks: 245\ninfrastructure: \"Pour molten Seared Stone through Smeltery drain/faucet into Casting Basin. Basin is not consumed. No Casting Table, Blank Cast or Block Mold required.\"\noverridePriority: \"NHCore removes native basin recipe for Smeltery@4 atL1532, then installs this360mB recipe atL1852.\"\nbasinBootstrap: {\"sqliteRecipeId\": 240307, \"source_id\": \"oracle:local-2.9.0-beta-2:crafting:shaped:c2d74cc729c3d36b\", \"inputs\": [{\"id\": \"tconstruct:smeltery@2\", \"amount\": 7}], \"output\": {\"id\": \"tconstruct:searedblock@2\", \"amount\": 1}, \"source\": \"https://github.com/GTNewHorizons/NewHorizonsCoreMod/blob/2.9.84/src/main/java/com/dreammaster/scripts/ScriptTinkersConstruct.java#L258\"}\ndurationMeaning: \"245 ticks is casting cooling time, not total Smeltery heating/pouring time.\""];
"istone.seared" -> "rpatch:verified:rc2:tconstruct:casting-basin:seared-stone" [label="360 mB"];
"itconstruct:searedblock@2" -> "rpatch:verified:rc2:tconstruct:casting-basin:seared-stone" [label="1 · reutilizable",style=dashed];
