"rpatch:verified:extrautils:sigil:activation" -> "ifactoryflow:division_sigil:active" [label="1"];
"rpatch:verified:extrautils:sigil:initial-wither-drop" [shape=box,style="filled",fillcolor="#faf0da",label="Adquisición · primer Wither\nderrotado por el jugador",tooltip="Invocar y derrotar un Wither: 4 Soul Sand y 3 Wither Skeleton Skulls para construirlo; el daño final debe atribuirse al jugador.\nRequiere doMobLoot=true y DivisionSigilEnabled=true (RC2 lo habilita). El primer Wither que mata ese jugador garantiza el drop de un Division Sigil inactivo.\nEl código incrementa PlayerPersisted.witherKills: garantiza cuando kills==1 o no existe hasSigil; en otros casos aplica nextInt(10)==0. Esta ruta corresponde al primer caso garantizado.\nEl sigil sin NBT es distinto del activo damage y del estable stable; no se usa como Pseudo-Inversion Sigil.\nTambién puede aparecer en cofres de estructuras si esa opción no está deshabilitada; esta rama utiliza el Wither y no presupone loot de cofre."];
"iminecraft:soul_sand" -> "rpatch:verified:extrautils:sigil:initial-wither-drop" [label="4"];
"iminecraft:skull@1" -> "rpatch:verified:extrautils:sigil:initial-wither-drop" [label="3"];
"rpatch:verified:extrautils:sigil:initial-wither-drop" -> "ifactoryflow:division_sigil:inactive" [label="1"];
