"rpatch:verified:rc2:tconstruct:smeltery:cobblestone-seared-fluid" [shape=box,style="filled",fillcolor="#faf0da",label="TConstruct Smeltery · melt\ncobblestone",tooltip="meltingTemperature: 800\namountSource: \"https://github.com/GTNewHorizons/TinkersConstruct/blob/1.14.118-GTNH/src/main/java/tconstruct/TConstruct.java#L126\"\namountDerivation: \"stoneLiquidValue = ingotLiquidValue/8 =144/8 =18mB per cobblestone.\"\ninfrastructure: \"Formed Smeltery with valid heat/fuel supply, controller, tank and drain. Casting Table and casts are not needed for melting.\"\nenergySystem: \"Smeltery heat/fuel, not EU. Duration and fuel amount vary with heating; no fixed numbers invented.\"\noverrideReview: \"Pinned NHCore ScriptTinkersConstruct removes selected melting recipes, but no removal of vanilla stone/cobblestone native melting was found.\"\nbootstrap: \"Twenty cobblestone supply360mB for one cast Seared Stone block.\""];
"iminecraft:cobblestone" -> "rpatch:verified:rc2:tconstruct:smeltery:cobblestone-seared-fluid" [label="1"];
