    {
      "id": "verified:extrautils:sigil:initial-wither-drop",
      "machineType": "Adquisición · primer Wither derrotado por el jugador",
      "inputs": [
        {
          "id": "minecraft:soul_sand",
          "amount": 4,
          "consumed": true
        },
        {
          "id": "minecraft:skull@1",
